#!/usr/bin/env bash
set -euo pipefail

for command in npx python3 pnpm; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$command is required to run Playwright browser validation." >&2
    exit 1
  fi
done

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export PWCLI="$CODEX_HOME/skills/playwright/scripts/playwright_cli.sh"
export PATH="$HOME/.local/bin:$PATH"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
harness_bin="${HARNESS_UI_BINARY:-$repo_root/.local/bin/harness}"
host="${HARNESS_UI_HOST:-127.0.0.1}"
port="${HARNESS_UI_PORT:-0}"
tmp_dir="$(mktemp -d)"
runtime_workdir="$tmp_dir/runtime-workdir"
server_log="$tmp_dir/harness-ui.log"
session_name="review-ui-$$-$RANDOM"
session_dir="$tmp_dir/playwright"
output_dir="${HARNESS_UI_OUTPUT_DIR:-output/playwright/$session_name}"
server_pid=""

log_phase() {
  printf '[review-ui-smoke] %s\n' "$*" >&2
}

cleanup() {
  if [[ -n "$server_pid" ]]; then
    kill "$server_pid" >/dev/null 2>&1 || true
    wait "$server_pid" >/dev/null 2>&1 || true
  fi
  "$PWCLI" --session "$session_name" close >/dev/null 2>&1 || true
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

if [[ ! -x "$harness_bin" ]]; then
  echo "Expected repo-local harness binary at ${harness_bin}" >&2
  echo "Run scripts/install-dev-harness first, or override HARNESS_UI_BINARY." >&2
  exit 1
fi

mkdir -p "$runtime_workdir" "$session_dir" "$output_dir"

log_phase "rebuilding embedded UI assets"
"$repo_root/scripts/build-embedded-ui" >/dev/null
log_phase "refreshing local harness binary"
"$repo_root/scripts/install-dev-harness" >/dev/null
harness_bin="${HARNESS_UI_BINARY:-$repo_root/.local/bin/harness}"

log_phase "seeding integrated-review read model"
python3 - "$runtime_workdir" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
plan_rel = "docs/plans/active/2026-04-02-review-ui-smoke.md"
plan_stem = "2026-04-02-review-ui-smoke"
plan_path = root / plan_rel
runtime = root / ".local" / "harness"
reviews = runtime / "plans" / plan_stem / "reviews"
plan_path.parent.mkdir(parents=True, exist_ok=True)
reviews.mkdir(parents=True, exist_ok=True)

plan_path.write_text(
    '''---
template_version: 0.3.0
created_at: "2026-04-02T10:00:00Z"
source_type: direct_request
source_refs: []
size: M
---

# Review UI Smoke

## Goal

Exercise the integrated-review read model in the browser.

### Decisions and Constraints

- Show one accountable reviewer and derived decision coverage.

## Scope

### In Scope

- Pending, blocked, and repaired finalize review rounds.

### Out of Scope

- Internal review artifact inspection.

## Acceptance Criteria

- [x] The review page renders reviewer, findings, and coverage state.

## Review Focus

- Verify decision and coverage remain understandable without orchestration detail.

## Deferred Items

- None.

## Work Breakdown

### Step 1: Build the review read model

- Done: [x]
- Outcome: Render one integrated reviewer with decision, findings, and coverage.
- Covers: Review page rendering.
- Check: Run the Playwright review smoke.

## Validation Strategy

- Exercise pending, blocked, and repaired rounds in a real browser.

## Closeout

- Validation: PENDING_UNTIL_ARCHIVE
- Review: PENDING_UNTIL_ARCHIVE
- Delivered: PENDING_UNTIL_ARCHIVE
- Not Delivered: PENDING_UNTIL_ARCHIVE
- Follow-Up Issues: NONE
- PR: PENDING_UNTIL_ARCHIVE
- Ready: PENDING_UNTIL_ARCHIVE
- Merge Handoff: PENDING_UNTIL_ARCHIVE
''',
    encoding="utf-8",
)

runtime.mkdir(parents=True, exist_ok=True)
(runtime / "current-plan.json").write_text(json.dumps({"plan_path": plan_rel}), encoding="utf-8")
(runtime / "plans" / plan_stem).mkdir(parents=True, exist_ok=True)
(runtime / "plans" / plan_stem / "state.json").write_text(
    json.dumps(
        {
            "execution_started_at": "2026-04-02T10:05:00Z",
            "current_node": "execution/finalize/review",
            "plan_path": plan_rel,
            "plan_stem": plan_stem,
            "revision": 1,
            "active_review_round": {
                "round_id": "review-003-delta",
                "kind": "delta",
                "revision": 1,
                "aggregated": False,
                "decision": "",
            },
            "finalize_coverage": {
                "root_round_id": "review-001-full",
                "tip_round_id": "review-002-delta",
                "covered_head_sha": "fixture-head-002",
                "revision": 1,
                "unresolved_blocking_count": 0,
            },
        }
    ),
    encoding="utf-8",
)

def seed_round(round_id, kind, title, head, created_at, *, anchor="", repair=None, submitted=True, summary="", aggregate=None):
    round_dir = reviews / round_id
    submission = round_dir / "submissions" / "integrated" / "submission.json"
    submission.parent.mkdir(parents=True, exist_ok=True)
    manifest = {
        "round_id": round_id,
        "kind": kind,
        "reviewed_head_sha": head,
        "revision": 1,
        "review_title": title,
        "review_focus": "Check the complete candidate and its continuous review coverage.",
        "plan_path": plan_rel,
        "plan_stem": plan_stem,
        "created_at": created_at,
        "ledger_path": str(round_dir / "ledger.json"),
        "aggregate_path": str(round_dir / "aggregate.json"),
        "submissions_dir": str(round_dir / "submissions"),
        "assignments": [
            {
                "slot": "integrated",
                "role": "integrated",
                "instructions": "Review the complete candidate against the fixed integrated rubric.",
                "review_focus": "Check the complete candidate and its continuous review coverage.",
                "submission_path": str(submission),
            }
        ],
    }
    if anchor:
        manifest["anchor_sha"] = anchor
    if repair:
        manifest["repair"] = repair
    (round_dir / "manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
    ledger_item = {
        "slot": "integrated",
        "role": "integrated",
        "status": "submitted" if submitted else "pending",
        "submission_path": str(submission),
    }
    if submitted:
        ledger_item["submitted_at"] = created_at
    (round_dir / "ledger.json").write_text(
        json.dumps({"round_id": round_id, "kind": kind, "updated_at": created_at, "assignments": [ledger_item]}),
        encoding="utf-8",
    )
    submission.write_text(
        json.dumps(
            {
                "round_id": round_id,
                "slot": "integrated",
                "role": "integrated",
                "by": "reviewer-integrated" if submitted else "",
                "submitted_at": created_at if submitted else "",
                "summary": summary,
                "resolutions": [],
                "findings": [],
            }
        ),
        encoding="utf-8",
    )
    if aggregate is not None:
        aggregate.setdefault("round_id", round_id)
        aggregate.setdefault("kind", kind)
        aggregate.setdefault("revision", 1)
        aggregate.setdefault("review_title", title)
        aggregate.setdefault("reviewed_head_sha", head)
        aggregate.setdefault("blocking_findings", [])
        aggregate.setdefault("non_blocking_findings", [])
        aggregate.setdefault("resolved_finding_ids", [])
        aggregate.setdefault("unresolved_finding_ids", [])
        aggregate.setdefault("unresolved_blocking_findings", [])
        aggregate.setdefault("aggregated_at", created_at)
        if repair:
            aggregate["repair"] = repair
        (round_dir / "aggregate.json").write_text(json.dumps(aggregate), encoding="utf-8")

blocking = {
    "finding_id": "review-001-full/integrated/001",
    "slot": "integrated",
    "role": "integrated",
    "area": "review-coverage",
    "severity": "important",
    "title": "Coverage can drift after review",
    "details": "Archive must reject product changes beyond the reviewed head.",
    "locations": ["internal/reviewcoverage/closeout.go"],
}
seed_round(
    "review-001-full",
    "full",
    "Initial full review",
    "fixture-head-001",
    "2026-04-02T11:00:00Z",
    summary="One blocking coverage defect remains.",
    aggregate={
        "decision": "changes_requested",
        "blocking_findings": [blocking],
        "unresolved_finding_ids": [blocking["finding_id"]],
        "unresolved_blocking_findings": [blocking],
    },
)

repair = {"round_id": "review-001-full", "finding_ids": [blocking["finding_id"]]}
minor = {
    "finding_id": "review-002-delta/integrated/001",
    "slot": "integrated",
    "role": "integrated",
    "area": "docs-consistency",
    "severity": "minor",
    "title": "Minor documentation note",
    "details": "Clarify the reviewed-head wording before stable release.",
    "locations": ["docs/specs/state-model.md"],
}
seed_round(
    "review-002-delta",
    "delta",
    "Linked repair review",
    "fixture-head-002",
    "2026-04-02T12:00:00Z",
    anchor="fixture-head-001",
    repair=repair,
    summary="The repair closes the blocking coverage defect.",
    aggregate={
        "decision": "pass",
        "non_blocking_findings": [minor],
        "resolved_finding_ids": [blocking["finding_id"]],
    },
)

seed_round(
    "review-003-delta",
    "delta",
    "Current integrated review",
    "fixture-head-003",
    "2026-04-02T13:00:00Z",
    anchor="fixture-head-002",
    repair={"round_id": "review-002-delta", "finding_ids": []},
    submitted=False,
)
PY

log_phase "starting harness ui on ${host}:${port}"
(
  cd "$runtime_workdir"
  "$harness_bin" ui --no-open --host "$host" --port "$port" >"$server_log" 2>&1
) &
server_pid="$!"

base_url=""
for _ in $(seq 1 150); do
  base_url="$(sed -n 's/^Harness UI listening at \(http:\/\/[^[:space:]]*\)$/\1/p' "$server_log" | tail -n 1)"
  if [[ -n "$base_url" ]] && curl -sf "${base_url}/review" >/dev/null; then
    break
  fi
  sleep 0.2
done
if [[ -z "$base_url" ]]; then
  echo "Harness UI failed to start for review smoke." >&2
  cat "$server_log" >&2 || true
  exit 1
fi

snapshot_to_file() {
  local destination="$1"
  "$PWCLI" --session "$session_name" snapshot | awk '
    /^```yaml$/ { capture=1; next }
    capture && /^```$/ { exit }
    capture { print }
  ' >"$destination"
  [[ -s "$destination" ]]
}

assert_has_text() {
  local file="$1"
  local expected="$2"
  if ! grep -Fq -- "$expected" "$file"; then
    echo "Snapshot ${file} did not contain expected text: ${expected}" >&2
    cat "$file" >&2
    exit 1
  fi
}

assert_not_has_text() {
  local file="$1"
  local unexpected="$2"
  if grep -Fq -- "$unexpected" "$file"; then
    echo "Snapshot ${file} unexpectedly contained text: ${unexpected}" >&2
    cat "$file" >&2
    exit 1
  fi
}

round_ref() {
  local label="$1"
  local snapshot="$2"
  grep -F "$label" "$snapshot" | grep '\[ref=e' | head -n 1 | sed -n 's/.*\[ref=\(e[0-9][0-9]*\)\].*/\1/p' || true
}

log_phase "opening integrated review workspace"
"$PWCLI" --session "$session_name" open "${base_url}/review" >/dev/null
snapshot_to_file "${output_dir}/review-pending.yml"
"$PWCLI" --session "$session_name" screenshot >/dev/null

assert_has_text "${output_dir}/review-pending.yml" "Current integrated review"
assert_has_text "${output_dir}/review-pending.yml" "Waiting for review"
assert_has_text "${output_dir}/review-pending.yml" "Independent reviewer"
assert_has_text "${output_dir}/review-pending.yml" "Independent review is still in progress."
assert_has_text "${output_dir}/review-pending.yml" "Coverage"
assert_not_has_text "${output_dir}/review-pending.yml" "Specialist"
assert_not_has_text "${output_dir}/review-pending.yml" "Raw JSON"
assert_not_has_text "${output_dir}/review-pending.yml" "Worklog"
assert_not_has_text "${output_dir}/review-pending.yml" "Aggregate"

blocked_ref="$(round_ref "Initial full review" "${output_dir}/review-pending.yml")"
if [[ -z "$blocked_ref" ]]; then
  echo "Could not find blocked full review round." >&2
  cat "${output_dir}/review-pending.yml" >&2
  exit 1
fi
"$PWCLI" --session "$session_name" click "$blocked_ref" >/dev/null
snapshot_to_file "${output_dir}/review-blocked.yml"
assert_has_text "${output_dir}/review-blocked.yml" "Changes requested"
assert_has_text "${output_dir}/review-blocked.yml" "reviewer-integrated"
assert_has_text "${output_dir}/review-blocked.yml" "Coverage can drift after review"
assert_has_text "${output_dir}/review-blocked.yml" "Archive must reject product changes beyond the reviewed head."
assert_has_text "${output_dir}/review-blocked.yml" "Blocked"
assert_has_text "${output_dir}/review-blocked.yml" "fixture-head-001"

repair_ref="$(round_ref "Linked repair review" "${output_dir}/review-blocked.yml")"
if [[ -z "$repair_ref" ]]; then
  echo "Could not find linked repair review round." >&2
  cat "${output_dir}/review-blocked.yml" >&2
  exit 1
fi
"$PWCLI" --session "$session_name" click "$repair_ref" >/dev/null
snapshot_to_file "${output_dir}/review-repaired.yml"
assert_has_text "${output_dir}/review-repaired.yml" "Pass"
assert_has_text "${output_dir}/review-repaired.yml" "The repair closes the blocking coverage defect."
assert_has_text "${output_dir}/review-repaired.yml" "Minor documentation note"
assert_has_text "${output_dir}/review-repaired.yml" "Clean"
assert_has_text "${output_dir}/review-repaired.yml" "fixture-head-002"
assert_has_text "${output_dir}/review-repaired.yml" "review-001-full"
assert_not_has_text "${output_dir}/review-repaired.yml" "slot integrated"
assert_not_has_text "${output_dir}/review-repaired.yml" "Integrated role"

log_phase "checking responsive review layout"
"$PWCLI" --session "$session_name" run-code 'async (page) => {
  await page.setViewportSize({ width: 760, height: 900 });
  const frame = page.locator(".workbench-page");
  const explorer = page.locator(".workbench-explorer");
  const inspector = page.locator(".workbench-inspector");
  if (!(await frame.count()) || !(await explorer.count()) || !(await inspector.count())) {
    throw new Error("missing review workbench regions");
  }
  const explorerBox = await explorer.boundingBox();
  const inspectorBox = await inspector.boundingBox();
  if (!explorerBox || !inspectorBox || inspectorBox.y < explorerBox.y + explorerBox.height - 1) {
    throw new Error("review mobile layout did not stack inspector below explorer");
  }
  return true;
}' >/dev/null

log_phase "review UI smoke validation passed"
echo "Playwright review UI smoke validation passed for ${base_url}"
echo "Review smoke snapshots written to ${output_dir}"
