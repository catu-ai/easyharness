#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
web_dir="${repo_root}/web"

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is required to build embedded UI assets." >&2
  echo "Install Node.js and pnpm, then rerun this command." >&2
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required to build embedded UI assets." >&2
  echo "Install Node.js and pnpm, then rerun this command." >&2
  exit 1
fi

if [[ ! -d "${web_dir}" ]]; then
  echo "missing frontend source directory at ${web_dir}" >&2
  exit 1
fi

cd "${web_dir}"
CI=true pnpm install --frozen-lockfile
build_output=""
if build_output="$(pnpm build 2>&1)"; then
  printf '%s\n' "${build_output}"
else
  build_status=$?
  printf '%s\n' "${build_output}" >&2
  if [[ "${build_output}" == *"The service was stopped"* || "${build_output}" == *"write EPIPE"* ]]; then
    echo "Embedded UI build hit a transient esbuild service failure; retrying once." >&2
    pnpm build
    exit $?
  fi
  exit "${build_status}"
fi
