{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/catu-ai/easyharness/tree/main/schema/inputs/review.spec.schema.json",
  "$ref": "#/$defs/ReviewSpec",
  "$defs": {
    "ReviewAssignmentSpec": {
      "properties": {
        "slot": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "dimensions": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "instructions": {
          "type": "string"
        },
        "risk_brief": {
          "$ref": "#/$defs/ReviewRiskBrief"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "slot",
        "role",
        "dimensions",
        "instructions"
      ],
      "description": "ReviewAssignmentSpec is one controller-selected reviewer assignment."
    },
    "ReviewRepairReference": {
      "properties": {
        "round_id": {
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 0
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "round_id",
        "finding_ids"
      ],
      "description": "ReviewRepairReference identifies the findings targeted by a repair delta."
    },
    "ReviewRiskBrief": {
      "properties": {
        "risk_surfaces": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "invariants": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1
        },
        "failure_modes": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "risk_surfaces",
        "invariants"
      ],
      "description": "ReviewRiskBrief gives a specialist a concrete risk surface to challenge."
    },
    "ReviewSpec": {
      "properties": {
        "step": {
          "type": "integer",
          "description": "Step is the tracked plan step number when the review is step-scoped."
        },
        "kind": {
          "type": "string",
          "description": "Kind is the review kind, such as delta or full."
        },
        "anchor_sha": {
          "type": "string",
          "description": "AnchorSHA is the controller-chosen git commit anchor for delta review. Delta review expects this to resolve to a real commit."
        },
        "review_title": {
          "type": "string",
          "description": "ReviewTitle is the human-readable title for finalize or custom review rounds."
        },
        "repair": {
          "$ref": "#/$defs/ReviewRepairReference",
          "description": "Repair identifies an earlier round and findings that this delta review intends to resolve."
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/ReviewAssignmentSpec"
          },
          "type": "array",
          "minItems": 1,
          "description": "Assignments lists the explicit reviewer-owned submission assignments."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "assignments"
      ],
      "description": "ReviewSpec is the JSON input consumed by `harness review start`."
    }
  },
  "title": "Review start input",
  "description": "JSON input consumed by `harness review start`."
}
